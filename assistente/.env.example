# Copie para .env.local (NÃO .env: o deploy do Firebase enviaria o .env para a nuvem)

# Chave da API Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# ID do projeto Firebase (o mesmo de VITE_FIREBASE_PROJECT_ID).
# Se ficar vazio, o servidor NÃO verifica login (use só no seu computador).
FIREBASE_PROJECT_ID=

# Opcionais
ASSISTENTE_MODELO=claude-opus-5-5
ASSISTENTE_ESFORCO=medium
ASSISTENTE_LIMITE_HORA=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
